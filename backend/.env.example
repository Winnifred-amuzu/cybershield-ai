CYBERSHIELD_ENV=development
CYBERSHIELD_JWT_SECRET=replace-with-a-long-random-secret
CYBERSHIELD_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CYBERSHIELD_MAX_MESSAGE_LENGTH=5000
CYBERSHIELD_MAX_URL_LENGTH=2048
CYBERSHIELD_MAX_REQUEST_BODY_BYTES=65536
CYBERSHIELD_RATE_LIMIT_WINDOW_SECONDS=60
CYBERSHIELD_RATE_LIMIT_MAX_REQUESTS=60
CYBERSHIELD_AUTH_RATE_LIMIT_MAX_REQUESTS=10
CYBERSHIELD_SCAM_THRESHOLD=0.50
